// use prisma-next

model User {
  id Int @id @default(autoincrement())
  username String @unique
  password String
  name String
  email String @unique
  workouts Workout[] 
}

model Exercise {
  id Int @id @default(autoincrement())
  name String
  category String
  muscleGroup String
  workoutSet WorkoutSet[]
}

model Workout {
  id Int @id @default(autoincrement())
  userId Int
  date DateTime
  notes String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  sets WorkoutSet[]
}

model WorkoutSet {
  id Int @id @default(autoincrement())
  workoutId Int
  exerciseId Int
  reps Int
  weight Float
  setNumber Int
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  workout Workout @relation(fields: [workoutId], references: [id])
}